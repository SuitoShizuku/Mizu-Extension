{
  "name": "Mizu Extension",
  "description": "Shizukuの欲しい機能をまとめたやつ",
  "version": "1.0.0",
  "manifest_version": 3,
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "action": {
    "default_title": "コンパクト設定を開く",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel/default.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "author": {
    "email": "mochimizu@suitomisu.com"
  },
  "short_name": "MizuX",
  "content_scripts": [
    {
      "matches": [ "https://*.gigafile.nu/*", "https://gigafile.nu/" ],
      "js": [ "gigafile.js" ]
    },
    {
      "matches": [ "https://www.youtube.com/*" ],
      "js": [ "youtube.js" ]
    }
  ]
}