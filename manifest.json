{
  "name": "Mizu Extension",
  "description": "Shizukuの欲しい機能をまとめたやつ",
  "version": "1.0.0",
  "manifest_version": 3,
  "permissions": [
    "sidePanel",
    "storage",
    "tabCapture",
    "offscreen",
    "activeTab",
    "tabs"
  ],
  "action": {
    "default_title": "コンパクト設定を開く",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel/default.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["ShizukuExtension/mizuEQ/styles.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "author": {
    "email": "mochimizu@suitomisu.com"
  },
  "homepage_url": "https://suitomizu.com/",
  "short_name": "MizuX",
  "content_scripts": [
    {
      "matches": [ "https://*.gigafile.nu/*", "https://gigafile.nu/" ],
      "js": [ "gigafile.js" ]
    },
    {
      "matches": [ "https://www.youtube.com/*" ],
      "js": [ "youtube.js" ]
    },
    {
      "matches": [ "https://www.youtube.com/watch*" ],
      "js": [ "ShizukuExtension/youtubeBackur/content.js" ],
      "css": [ "ShizukuExtension/youtubeBackur/content.css" ]
    },
    {
      "matches": [ "<all_urls>" ],
      "js": [ "ShizukuExtension/mizuEQ/content/content.js" ],
      "css": [ "ShizukuExtension/mizuEQ/styles.css" ],
      "run_at": "document_idle"
    },
    {
      "matches": [ "https://www.densuke.biz/event*", "https://www.densuke.biz/edit2?cd=*", "https://densuke.biz/event*", "https://densuke.biz/edit2?cd=*"],
      "js": [ "densuke.js" ]
    },
    {
      "matches": [ "https://iachara.com/*" ],
      "js": [ "iachara.js" ],
      "css": [ "ShizukuExtension/iariri/iachara.css" ]
    }
  ]
}