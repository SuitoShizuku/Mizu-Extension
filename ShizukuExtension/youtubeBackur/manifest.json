{
  "manifest_version": 3,
  "name": "YouTubeBackur - 背景動画プレイヤー",
  "version": "1.0.0",
  "description": "YouTubeの通常プレイヤー再生時に、動画をページ全体の最背景へ軽量かつ美しく配置します。",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
